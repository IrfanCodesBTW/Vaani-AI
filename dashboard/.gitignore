# Secrets. Never commit real keys.
.env

# Runtime state (auto-created and seeded on first boot).
data/
!data/.gitkeep

# Dependencies (there are none, but never sync these if they ever appear).
node_modules
node_modules.nosync

# Legacy reference, kept local only.
_legacy

# Old flat-file agent store, superseded by data/db.json.
agents.json

# Logs and OS cruft.
*.log
test_*.log
.DS_Store
public/samples/*.tmp

# Challenger/interim test artifacts (canonical tests are tracked).
test/challenger*/
test/test_m3_*
test/test_m2_responsive*
test/challenger_m3_*
package-lock.json
